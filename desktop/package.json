{
  "name": "noctis-studio-desktop",
  "productName": "Noctis Studio",
  "version": "0.1.0",
  "description": "Noctis Studio Desktop: produção de vídeos, Audio Atlas e Renomeador num app só",
  "author": "Cristian",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5199 && cross-env NOCTIS_DEV_URL=http://localhost:5199 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test test/renomeador.test.js test/auth.test.js test/tags.test.js test/fila.test.js test/srt.test.js && node electron/servicos/audio-atlas/parser.js && node electron/servicos/audio-atlas/categorize.js && node electron/servicos/audio-atlas/library.js",
    "dist": "npm run build && electron-builder --win --publish never",
    "test:flow": "node --test test/flow-falso.test.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "studio.noctis.desktop",
    "productName": "Noctis Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NoctisStudio-Setup-${version}.exe",
      "shortcutName": "Noctis Studio"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  }
}
