{
  "name": "noctis-studio-desktop",
  "productName": "Noctis Studio",
  "version": "0.1.12",
  "description": "Noctis Studio Desktop: produção de vídeos, Audio Atlas e Renomeador num app só",
  "author": "Cristian",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5199 && cross-env NOCTIS_DEV_URL=http://localhost:5199 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test --test-concurrency=1 test/renomeador.test.js test/auth.test.js test/tags.test.js test/fila.test.js test/srt.test.js test/chat.test.js test/drivers.test.js test/atualizacao.test.js test/ia-nucleo.test.js test/ia-api.test.js test/ia-mcp.test.js test/ia-migracao.test.js test/flow-conta.test.js && node electron/servicos/audio-atlas/parser.js && node electron/servicos/audio-atlas/categorize.js && node electron/servicos/audio-atlas/library.js",
    "dist": "npm run build && electron-builder --win --publish never",
    "test:flow": "node --test test/flow-falso.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "studio.noctis.desktop",
    "productName": "Noctis Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NoctisStudio-Setup-${version}.exe",
      "shortcutName": "Noctis Studio"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "electron/servicos/chat/mcp-server.js",
      "electron/servicos/ia/**",
      "electron/servicos/audio-atlas/**",
      "electron/servicos/renomeador.js",
      "electron/lib/store.js"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://noctis-studio.online/api/desktop/update/",
        "channel": "latest",
        "useMultipleRangeRequest": false
      }
    ],
    "extraResources": [
      {
        "from": "../NOCTIS-STUDIO-PARA-IAS.md",
        "to": "NOCTIS-STUDIO-PARA-IAS.md"
      }
    ]
  }
}
