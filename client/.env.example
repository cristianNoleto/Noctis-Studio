# Supabase (autenticação real). Sem estes valores o app roda em MODO LOCAL
# (login simulado no navegador). Pegue os dois em:
# Supabase → seu projeto → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Widget flutuante de WhatsApp (login) — sem número o widget fica oculto
VITE_WHATSAPP_PHONE=
VITE_WHATSAPP_MESSAGE=Olá! Vim pelo Noctis Studio.

# Links de comunidade
VITE_WHATSAPP_COMMUNITY_URL=
VITE_DISCORD_URL=
VITE_YOUTUBE_URL=

# Suporte
VITE_SUPPORT_EMAIL=

# hCaptcha (sitekey e PUBLICA; a secret vai so no painel do Supabase)
VITE_HCAPTCHA_SITEKEY=443aa96a-9714-4f6c-a246-c51437043e60
