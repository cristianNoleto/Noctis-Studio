PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Supabase (service role — apenas no servidor, nunca no client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (fila BullMQ + cache de rotação de chaves) — Fase 4+
REDIS_URL=redis://localhost:6379

# Chave de criptografia das chaves de API dos usuários (BYOK) — 32 bytes hex
API_KEY_ENCRYPTION_SECRET=

# Send Email Hook (e-mails de auth multilingues via Resend)
RESEND_API_KEY=
EMAIL_FROM=Noctis Studio <noreply@noctis-studio.online>
SEND_EMAIL_HOOK_SECRET=
